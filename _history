ot present3:\n            present3 = True\n            turnHalf(AnalogPin.P12)\n    else:\n        present3 = False\n    # station 4: reader P10 -> servo P16\n    pins.digital_write_pin(DigitalPin.P10, 0)\n    id4 = MFRC522.get_id()\n    pins.digital_write_pin(DigitalPin.P10, 1)\n    if id4 != \"\":\n        if not present4:\n            present4 = True\n            turnHalf(AnalogPin.P16)\n    else:\n        present4 = False\nbasic.forever(on_forever)\n"}]},{"timestamp":1795100771817,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":395,"length1":31,"diffs":[[1,"    \"preferredEditor\": \"blocksprj\"\n"]]}]}]},{"timestamp":1795101565209,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":0,"diffs":[[1,"let present4 = false\nlet id4 = 0\nlet present3 = false\nlet id3 = 0\nlet present2 = false\nlet id2 = 0\nlet present1 = false\nlet id1 = 0\nled.enable(false)\nfunction turnHalf(servo: AnalogPin) {\n    pins.servoWritePin(servo, 110)   // spin\n    basic.pause(90)                  // 180°\n    pins.servoWritePin(servo, 90)    // stop\n}\n// reader select pins (SDA): all high = no reader active\npins.digitalWritePin(DigitalPin.P0, 1)\npins.digitalWritePin(DigitalPin.P1, 1)\npins.digitalWritePin(DigitalPin.P2, 1)\npins.digitalWritePin(DigitalPin.P10, 1)\n// servos stopped at start\npins.servoWritePin(AnalogPin.P8, 90)\npins.servoWritePin(AnalogPin.P9, 90)\npins.servoWritePin(AnalogPin.P11, 90)\npins.servoWritePin(AnalogPin.P12, 90)\nMFRC522.Init()\nbasic.forever(function () {\n    // station 1: reader P0 -> servo P8\n    pins.digitalWritePin(DigitalPin.P0, 0)\n    id1 = MFRC522.getID()\n    pins.digitalWritePin(DigitalPin.P0, 1)\n    if (id1 != 0) {\n        if (!(present1)) {\n            present1 = true\n            turnHalf(AnalogPin.P8)\n        }\n    } else {\n        present1 = false\n    }\n    // station 2: reader P1 -> servo P9\n    pins.digitalWritePin(DigitalPin.P1, 0)\n    id2 = MFRC522.getID()\n    pins.digitalWritePin(DigitalPin.P1, 1)\n    if (id2 != 0) {\n        if (!(present2)) {\n            present2 = true\n            turnHalf(AnalogPin.P9)\n        }\n    } else {\n        present2 = false\n    }\n    // station 3: reader P2 -> servo P12\n    pins.digitalWritePin(DigitalPin.P2, 0)\n    id3 = MFRC522.getID()\n    pins.digitalWritePin(DigitalPin.P2, 1)\n    if (id3 != 0) {\n        if (!(present3)) {\n            present3 = true\n            turnHalf(AnalogPin.P12)\n        }\n    } else {\n        present3 = false\n    }\n    // station 4: reader P10 -> servo P16\n    pins.digitalWritePin(DigitalPin.P10, 0)\n    id4 = MFRC522.getID()\n    pins.digitalWritePin(DigitalPin.P10, 1)\n    if (id4 != 0) {\n        if (!(present4)) {\n            present4 = true\n            turnHalf(AnalogPin.P16)\n        }\n    } else {\n        present4 = false\n    }\n})\n"]]}]}]},{"timestamp":1795101567724,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":1801,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"u8,6`[GSbPfRUb/Mri_^\">id1</variable><variable id=\"0(I0Lf!)nRB[uNs4G?#G\">present1</variable><variable id=\"341y9hI9gK_c4Ea)xT$k\">id2</variable><variable id=\"KdDW?::iMoxFgn1DSMnZ\">present2</variable><variable id=\"Rq_!h_SVVT;fscQz{F^h\">id3</variable><variable id=\"Ncw{O5jygh4V|[r)9AkM\">present3</variable><variable id=\"t{(slv;5N!W0*t@iGtVW\">id4</variable><variable id=\"d~8@D/,cAA]Z+tX}A~e6\">present4</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"device_led_enable\"><value name=\"on\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">FALSE</field></shadow></value><next><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"function turnHalf(servo: AnalogPin) {\" line1=\"    pins.servoWritePin(servo, 110)   // spin\